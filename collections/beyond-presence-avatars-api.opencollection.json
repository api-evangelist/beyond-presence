{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fast Agents Avatars API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "Avatars",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Avatars",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bey.dev/v1/avatars",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of objects to return."
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "Cursor for pagination."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "List available avatars, both your own and public ones."
        },
        {
          "info": {
            "name": "Retrieve Avatar",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bey.dev/v1/avatars/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Avatar ID."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Retrieve avatar by ID."
        }
      ]
    }
  ],
  "bundled": true
}