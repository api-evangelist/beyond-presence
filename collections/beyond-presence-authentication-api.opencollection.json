{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fast Agents Authentication API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Verify API Key",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bey.dev/v1/auth/verify",
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Verify authentication with API key."
        }
      ]
    }
  ],
  "bundled": true
}