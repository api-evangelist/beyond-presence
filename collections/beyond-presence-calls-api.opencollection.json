{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fast Agents Calls API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "Calls",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Calls",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bey.dev/v1/calls",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of objects to return."
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "Cursor for pagination."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "List calls managed by your agents."
        },
        {
          "info": {
            "name": "Create Call",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.bey.dev/v1/calls",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Create call."
        },
        {
          "info": {
            "name": "Retrieve Call",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bey.dev/v1/calls/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Call ID."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Retrieve call."
        },
        {
          "info": {
            "name": "List Call Messages",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bey.dev/v1/calls/:id/messages",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Call ID."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "List transcribed messages of a call."
        }
      ]
    }
  ],
  "bundled": true
}