{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fast Agents External APIs API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "External APIs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List External API Configurations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bey.dev/v1/external-apis",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of objects to return."
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "Cursor for pagination."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "List external API configurations."
        },
        {
          "info": {
            "name": "Create External API Configuration",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.bey.dev/v1/external-apis",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Create external API configuration."
        },
        {
          "info": {
            "name": "Retrieve External API Configuration",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bey.dev/v1/external-apis/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "External API configuration ID."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Retrieve external API configuration."
        },
        {
          "info": {
            "name": "Delete External API Configuration",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.bey.dev/v1/external-apis/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "External API configuration ID."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Delete external API configuration."
        }
      ]
    }
